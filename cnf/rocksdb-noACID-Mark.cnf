[mysqld]
plugin-load-add=rocksdb=ha_rocksdb.so
rocksdb=1

# binary log
binlog_row_image=minimal
#loose-binlog_space_limit=4G

# connections
connect_timeout=120
back_log=4K
max_connections=4K
max_prepared_stmt_count=4M

# general
table_open_cache=256K
table_open_cache_instances=64


# RocksDB
transaction-isolation=READ-COMMITTED
rocksdb_block_cache_size=8G
rocksdb_max_background_jobs=16
rocksdb_default_cf_options=level_compaction_dynamic_level_bytes=true;block_based_table_factory={cache_index_and_filter_blocks=1;filter_policy=bloomfilter:10:false;whole_key_filtering=1};optimize_filters_for_hits=true;max_write_buffer_number=4;write_buffer_size=32m;max_bytes_for_level_base=256m;compression_per_level=kNoCompression;bottommost_compression=kLZ4Compression
rocksdb_cache_high_pri_pool_ratio=0.5

rocksdb_max_open_files=-1
rocksdb_max_total_wal_size=4G
rocksdb_merge_buf_size=1G
#rocksdb_default_cf_options=write_buffer_size=512M;target_file_size_base=1G;max_bytes_for_level_base=512M;level0_file_num_compaction_trigger=4;level0_slowdown_writes_trigger=10;level0_stop_writes_trigger=15;max_write_buffer_number=2;compression=kLZ4Compression;bottommost_compression=kLZ4Compression;compression_opts=-14:4:0;block_based_table_factory={cache_index_and_filter_blocks=1;filter_policy=bloomfilter:10:false;whole_key_filtering=0};level_compaction_dynamic_level_bytes=true;optimize_filters_for_hits=true;memtable_prefix_bloom_size_ratio=0.05;prefix_extractor=capped:12;compaction_pri=kMinOverlappingRatio

# rocksdb_max_subcompactions=4
# rocksdb_compaction_readahead_size=16m
#rocksdb_use_direct_reads=ON
#rocksdb_use_direct_io_for_flush_and_compaction=ON
# rocksdb_write_policy=write_unprepared


# Non-ACID compliant options but improve stability of results
sync_binlog=1024
rocksdb_flush_log_at_trx_commit=0
